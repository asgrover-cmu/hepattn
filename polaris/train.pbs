#!/bin/bash -l
#PBS -N clic-train
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=48:00:00
#PBS -j oe
#
# Submit with submit_train.sh, which injects -A / -q / -l filesystems / -o from env.sh
# and snapshots the config into polaris/runs/<run-id>/. One Polaris node = 4x A100-40GB;
# Lightning spawns the 4 DDP ranks itself (trainer.devices: 4), so this is ONE python
# process, not mpiexec.

set -euo pipefail

export REPO_DIR="${REPO_DIR:?REPO_DIR not set}"
export RUN_DIR="${RUN_DIR:?RUN_DIR not set}"
cd "${REPO_DIR}"
source polaris/env.sh
[ -f "${RUN_DIR}/config.yaml" ] || { echo "FATAL: no snapshot at ${RUN_DIR}/config.yaml" >&2; exit 1; }

# PBS does not inherit the interactive shell's proxy exports; without these CometML
# logging silently fails with "Network is unreachable". Override PROXY in env.sh if needed.
PROXY="${PROXY:-http://proxy.alcf.anl.gov:3128}"
export http_proxy="${PROXY}" https_proxy="${PROXY}" HTTP_PROXY="${PROXY}" HTTPS_PROXY="${PROXY}"

# A stale ~/.local can shadow the venv's torch and produce a fake CUDA mismatch.
export PYTHONNOUSERSITE=1

# hepattn is NOT installed into the venv (uv sync --no-install-project), so PYTHONPATH
# alone decides which clone runs. The venv lives under WORK_ROOT, the checkout under $HOME.
VENV_DIR="${VENV_DIR:-${WORK_ROOT}/hepattn/.venv}"
# No `source activate`: the Polaris venv has no working activate script (found on 2026-09-22),
# so put its bin/ first on PATH, which is all activate would do.
[ -x "${VENV_DIR}/bin/python" ] || { echo "FATAL: no python at ${VENV_DIR}/bin/python (set VENV_DIR)" >&2; exit 1; }
export VIRTUAL_ENV="${VENV_DIR}"
export PATH="${VENV_DIR}/bin:${PATH}"
export PYTHONPATH="${REPO_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"

# Preflight: train THIS checkout, and every data file the snapshot names must exist.
python - <<PYCHK || exit 1
import os, sys, yaml, hepattn
repo = os.environ["REPO_DIR"]
if not hepattn.__file__.startswith(os.path.join(repo, "src")):
    sys.exit(f"FATAL: hepattn resolves to {hepattn.__file__}, not {repo}/src")
cfg = yaml.safe_load(open(os.path.join(os.environ["RUN_DIR"], "config.yaml")))
for k in ("train_path", "valid_path"):
    p = cfg["data"][k]
    if not os.path.isfile(p):
        sys.exit(f"FATAL: data.{k} does not exist: {p}")
root = cfg["trainer"]["default_root_dir"]
if not os.path.isabs(root) or root.startswith(os.path.expanduser("~")):
    sys.exit(f"FATAL: default_root_dir must be absolute and off \$HOME (45 GB quota): {root}")
print(f"preflight OK: hepattn -> {hepattn.__file__}; logs -> {root}")
PYCHK

# Triton builds its CUDA helper with $CC; Polaris defaults to NVHPC's nvc, which rejects
# GCC-only flags. loss.py wraps cost functions in torch.compile, so this always matters.
export CC="${CC_OVERRIDE:-$(command -v gcc || true)}"
export CXX="${CXX_OVERRIDE:-$(command -v g++ || true)}"
[ -n "${CC}" ] || { echo "FATAL: no gcc on PATH (set CC_OVERRIDE)" >&2; exit 1; }
echo "==> Triton C compiler: ${CC} ($(${CC} --version 2>/dev/null | head -1))"

export OMP_NUM_THREADS=8            # 32 cores / 4 ranks
export COMET_OFFLINE_DIRECTORY="${WORK_ROOT}/comet-offline"
mkdir -p "$COMET_OFFLINE_DIRECTORY"

SMOKE_ARGS=""
if [ "${SMOKE:-0}" = "1" ]; then
  # >=40 steps: OneCycleLR phase 1 spans (pct_start*total_steps - 1) steps, and with
  # pct_start=0.05 a shorter run gives a span of 0 and divides by zero.
  SMOKE_ARGS="--trainer.max_epochs 1 --trainer.limit_train_batches 100 --trainer.limit_val_batches 10"
fi
EPOCH_ARG=""
[ -n "${EPOCHS:-}" ] && EPOCH_ARG="--trainer.max_epochs ${EPOCHS}"
RESUME_ARG=""
[ -n "${RESUME_CKPT:-}" ] && RESUME_ARG="--ckpt_path ${RESUME_CKPT}"

# Embed the run record in the job log itself.
echo "================ meta.txt ================"; cat "${RUN_DIR}/meta.txt"
echo "================ config.yaml (${RUN_DIR}) ================"; cat "${RUN_DIR}/config.yaml"
echo "================ overrides ================"
echo "smoke='${SMOKE_ARGS}' epochs='${EPOCH_ARG}' resume='${RESUME_ARG}'"
echo "==> host $(hostname)"
nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader
echo "==> starting $(date -Is)"

# scale_dict_path in the config is relative to this directory.
cd src/hepattn/experiments/clic
python main.py fit \
  --config "${RUN_DIR}/config.yaml" \
  --trainer.devices 4 \
  --trainer.num_nodes 1 \
  ${SMOKE_ARGS} ${EPOCH_ARG} ${RESUME_ARG}

echo "==> finished $(date -Is)"
